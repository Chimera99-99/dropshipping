<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>

    {%- liquid
      assign heading_font = settings.type_header_font
      assign body_font = settings.type_body_font
    -%}
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --font: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-head: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      }
      h1, h2, h3, .logo, .btn { font-family: var(--font-head); }
      .password-wrap {
        min-height: 100vh;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 40px 24px;
      }
    </style>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <div class="password-wrap">
      <div style="max-width: 520px;">
        <a href="{{ routes.root_url }}" class="logo" style="justify-content: center; margin-bottom: 24px;">
          <span class="logo__mark">{% render 'icon', name: 'paw-print', size: 18 %}</span>
          {{ shop.name }}<span class="tm">™</span>
        </a>
        {{ content_for_layout }}
      </div>
    </div>
  </body>
</html>
