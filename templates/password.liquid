<h1 class="h2">{{ 'general.password_page.title' | t }}</h1>
<p class="muted" style="margin: 12px 0 28px;">{{ 'general.password_page.subtext' | t }}</p>

{%- form 'customer' -%}
  <input type="hidden" name="contact[tags]" value="newsletter, password page">
  <div class="squad__form" style="justify-content: center;">
    <label class="visually-hidden" for="password-email">{{ 'sections.newsletter.email' | t }}</label>
    <input
      id="password-email"
      type="email"
      name="contact[email]"
      required
      placeholder="{{ 'sections.newsletter.placeholder' | t }}"
      style="background: #fff; box-shadow: var(--shadow-soft);"
    >
    <button type="submit" class="btn btn-primary">
      {% render 'icon', name: 'send', size: 17 %}
      Notify me
    </button>
  </div>
  {%- if form.posted_successfully? -%}
    <p class="form-note" style="margin-top: 16px;">{{ 'sections.newsletter.success' | t }}</p>
  {%- endif -%}
{%- endform -%}

<div style="margin-top: 40px; border-top: 1px solid var(--cream-200); padding-top: 28px;">
  <h2 class="h2" style="font-size: 1.05rem; margin-bottom: 12px;">
    {{ 'general.password_page.login_form_heading' | t }}
  </h2>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="form-note form-note--error">{{ form.errors.messages['form'] }}</div>
    {%- endif -%}
    <div class="squad__form" style="justify-content: center;">
      <label class="visually-hidden" for="store-password">
        {{ 'general.password_page.login_form_password_label' | t }}
      </label>
      <input
        id="store-password"
        type="password"
        name="password"
        required
        style="background: #fff; box-shadow: var(--shadow-soft);"
      >
      <button type="submit" class="btn btn-ghost">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
    </div>
  {%- endform -%}

  <p class="muted" style="margin-top: 20px; font-size: 0.85rem;">
    {{ 'general.password_page.admin_link_html' | t }}
  </p>
</div>
