<div class="page-head">
  <div class="container-x">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
  </div>
</div>

<section class="section">
  <div class="container-x" style="max-width: 460px;">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-note form-note--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-field">
        <label for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
        <input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="form-field">
        <label for="reset-confirm">{{ 'customer.reset_password.confirm' | t }}</label>
        <input id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn-primary btn-full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
