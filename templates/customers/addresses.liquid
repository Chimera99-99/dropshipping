<div class="page-head">
  <div class="container-x">
    <h1>{{ 'customer.addresses.title' | t }}</h1>
  </div>
</div>

<section class="section">
  <div class="container-x" style="max-width: 720px;">
    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div class="review" style="margin-bottom: 16px;">
          <div class="muted" style="font-size: 0.92rem;">{{ address | format_address }}</div>
          {%- if address == customer.default_address -%}
            <span class="price--save">{{ 'customer.addresses.default' | t }}</span>
          {%- endif -%}
          {%- form 'customer_address', address -%}
            <button type="submit" class="cart-line__remove" data-confirm-message="{{ 'customer.addresses.confirm' | t }}">
              {% render 'icon', name: 'trash-2', size: 15 %}
              {{ 'customer.addresses.delete' | t }}
            </button>
            <input type="hidden" name="_method" value="delete">
          {%- endform -%}
        </div>
      {%- endfor -%}
    {%- endpaginate -%}

    <h2 class="h2" style="font-size: 1.2rem; margin: 32px 0 16px;">
      {{ 'customer.addresses.add_new' | t }}
    </h2>

    {%- form 'customer_address', customer.new_address -%}
      <div class="form-field">
        <label for="addr-first">{{ 'customer.register.first_name' | t }}</label>
        <input id="addr-first" type="text" name="address[first_name]" autocomplete="given-name">
      </div>
      <div class="form-field">
        <label for="addr-last">{{ 'customer.register.last_name' | t }}</label>
        <input id="addr-last" type="text" name="address[last_name]" autocomplete="family-name">
      </div>
      <div class="form-field">
        <label for="addr-1">{{ 'customer.addresses.address1' | t }}</label>
        <input id="addr-1" type="text" name="address[address1]" autocomplete="address-line1">
      </div>
      <div class="form-field">
        <label for="addr-city">{{ 'customer.addresses.city' | t }}</label>
        <input id="addr-city" type="text" name="address[city]" autocomplete="address-level2">
      </div>
      <div class="form-field">
        <label for="addr-zip">{{ 'customer.addresses.zip' | t }}</label>
        <input id="addr-zip" type="text" name="address[zip]" autocomplete="postal-code">
      </div>
      <div class="form-field">
        <label for="addr-country">{{ 'customer.addresses.country' | t }}</label>
        <select id="addr-country" name="address[country]" class="select">
          {{ country_option_tags }}
        </select>
      </div>
      <button type="submit" class="btn btn-primary">{{ 'customer.addresses.save' | t }}</button>
    {%- endform -%}

    <a href="{{ routes.account_url }}" class="btn btn-ghost" style="margin-top: 24px;">
      {{ 'customer.order.back' | t }}
    </a>
  </div>
</section>
