{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money, shop: shop.name }}</title>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor-qrcode.js' | shopify_asset_url }}" defer></script>
  </head>

  <body class="template-gift-card">
    <section class="section" style="text-align: center;">
      <div class="container-x" style="max-width: 480px;">
        <span class="logo" style="justify-content: center; margin-bottom: 20px;">
          <span class="logo__mark">{% render 'icon', name: 'gift', size: 18 %}</span>
          {{ shop.name }}<span class="tm">™</span>
        </span>

        <h1 class="h2">{{ 'gift_cards.issued.subtext' | t }}</h1>

        <div class="review" style="margin-top: 24px; align-items: center;">
          <span class="price" style="font-size: 2.4rem;">
            {{ gift_card.balance | money }}
          </span>
          {%- if gift_card.balance != gift_card.initial_value -%}
            <span class="muted">{{ gift_card.initial_value | money }} originally</span>
          {%- endif -%}

          <div
            style="font-family: monospace; font-size: 1.2rem; letter-spacing: 0.12em; background: var(--cream-100); padding: 14px; border-radius: var(--r-md); word-break: break-all;"
          >
            {{ gift_card.code | format_code }}
          </div>

          <p class="muted" style="font-size: 0.9rem;">{{ 'gift_cards.issued.redeem' | t }}</p>

          {%- if gift_card.expired and gift_card.expires_on -%}
            <p class="form-note form-note--error">
              {{ 'gift_cards.issued.expires' | t: expiry: gift_card.expires_on | date: format: 'date' }}
            </p>
          {%- endif -%}
        </div>

        <a href="{{ shop.url }}" class="btn btn-primary btn-lg" style="margin-top: 24px;">
          {{ 'gift_cards.issued.shop_link' | t }}
        </a>
      </div>
    </section>
  </body>
</html>
