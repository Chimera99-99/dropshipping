{%- comment -%}
  Open Graph / Twitter card tags.
{%- endcomment -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">

{%- if request.page_type == 'product' and product -%}
  {%- assign og_image = product.featured_media.preview_image -%}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif request.page_type == 'article' and article -%}
  {%- assign og_image = article.image -%}
{%- elsif request.page_type == 'collection' and collection -%}
  {%- assign og_image = collection.featured_image -%}
{%- else -%}
  {%- assign og_image = settings.share_image -%}
{%- endif -%}

{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
