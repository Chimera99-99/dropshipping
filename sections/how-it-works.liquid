<section class="section">
  <div class="container-x grid-2-split">
    <div class="media-frame">
      <img src="{{ 'features.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="900" height="900" loading="lazy">
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h2" style="margin: 10px 0 16px;">{{ section.settings.heading }}</h2>
      <p class="muted">{{ section.settings.subheading }}</p>
      <ul class="feature-list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="feature-list__icon">{% render 'icon', name: block.settings.icon, size: 18 %}</span>
            <span><b>{{ block.settings.title }}</b> — {{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cooling comfort in three simple steps" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "No prep, no maintenance — just instant relief whenever your pet needs it." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Unroll" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "sparkles", "options": [
          { "value": "sparkles", "label": "Sparkles" },
          { "value": "cat", "label": "Cat" },
          { "value": "dog", "label": "Dog" },
          { "value": "refresh-cw", "label": "Refresh" },
          { "value": "snowflake", "label": "Snowflake" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "sparkles", "title": "Unroll", "text": "Place the mat anywhere — crate, sofa, floor, or car seat." } },
        { "type": "step", "settings": { "icon": "dog", "title": "Let your pet lie down", "text": "Cooling activates instantly under their body weight." } },
        { "type": "step", "settings": { "icon": "refresh-cw", "title": "Reset in minutes", "text": "Lift it, let air circulate, and it's cool again." } }
      ]
    }
  ]
}
{% endschema %}
