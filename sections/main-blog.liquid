<div class="page-head">
  <div class="container-x">
    <h1>{{ blog.title }}</h1>
  </div>
</div>

<section class="section">
  <div class="container-x">
    {%- paginate blog.articles by 12 -%}
      <div class="grid-4">
        {%- for article in blog.articles -%}
          <div class="reveal">
            <div class="card">
              {%- if article.image -%}
                <a href="{{ article.url }}" class="card__media">
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                </a>
              {%- endif -%}
              <div class="card__body">
                <span class="stars__count">{{ article.published_at | date: format: 'date' }}</span>
                <h3 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                <p class="muted" style="font-size: 0.92rem;">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
