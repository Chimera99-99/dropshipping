{%- comment -%}
  Homepage hero. Uses the hero.png lifestyle photo already bundled in assets.
{%- endcomment -%}

<section class="hero">
  <div class="hero__bg">
    <img src="{{ 'hero.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1600" height="1200" fetchpriority="high">
  </div>
  <div class="hero__scrim"></div>
  <div class="hero__veil"></div>
  <div class="hero__wash"></div>

  <div class="container-x hero__inner">
    <div class="hero__content">
      <div class="hero__copy">
        {%- if section.settings.pill != blank -%}
          <span class="hero__pill">{% render 'icon', name: 'paw-print', size: 14 %} {{ section.settings.pill }}</span>
        {%- endif -%}

        <h1 class="h1 hero__title">{{ section.settings.heading }}</h1>
        <p class="hero__sub">{{ section.settings.subheading }}</p>

        <div class="hero__cta">
          {%- if section.settings.cta_text != blank -%}
            <a href="{{ section.settings.cta_link | default: '#shop' }}" class="btn btn-primary btn-lg">
              {{ section.settings.cta_text }}
              {% render 'icon', name: 'arrow-right', size: 18 %}
            </a>
          {%- endif -%}
        </div>

        <div class="hero__proof">
          <span>{% render 'icon', name: 'star', size: 16, class: 'is-gold', fill: 'currentColor' %} <b>4.8/5</b>&nbsp;from 1,300+ reviews</span>
          <span>{% render 'icon', name: 'paw-print', size: 16 %} <b>10,000+</b>&nbsp;happy pets</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__chip hero__chip--1">
    <span class="is-sage">{% render 'icon', name: 'snowflake', size: 18 %}</span> Cool for hours
  </div>
  <div class="hero__chip hero__chip--2">
    <span class="is-cool">{% render 'icon', name: 'badge-check', size: 18 %}</span> 30-Day Guarantee
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill text", "default": "Loved by 10,000+ Pet Parents" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Cooling Mat Your Pet Will Fight To Nap On" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Instant relief from summer heat — no fridge, no gel, no fuss. Just cool comfort, every time they lie down." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop the Cooling Mat" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
