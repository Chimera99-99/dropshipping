{%- comment -%} Static trust strip beneath the hero. {%- endcomment -%}
<div class="trust">
  <div class="container-x trust__row">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        {% render 'icon', name: block.settings.icon, size: 18 %}
        {{ block.settings.text }}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free EU Shipping" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "star", "label": "Star" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "refresh-cw", "label": "Returns" },
            { "value": "paw-print", "label": "Paw" },
            { "value": "badge-check", "label": "Verified" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "star", "text": "4.8/5 from 1,300+ Reviews" } },
        { "type": "item", "settings": { "icon": "paw-print", "text": "10,000+ Mats Sold" } },
        { "type": "item", "settings": { "icon": "truck", "text": "Free EU Shipping Over €10" } },
        { "type": "item", "settings": { "icon": "shield-check", "text": "30-Day Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
