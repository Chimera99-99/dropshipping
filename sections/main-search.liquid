<div class="page-head">
  <div class="container-x">
    <h1>{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 460px; margin: 20px auto 0;">
      <div class="squad__form">
        <label class="visually-hidden" for="search-input">{{ 'general.search.placeholder' | t }}</label>
        <input
          id="search-input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          style="background: #fff; box-shadow: var(--shadow-soft);"
        >
        <button type="submit" class="btn btn-primary">
          {% render 'icon', name: 'search', size: 17 %}
          {{ 'general.search.submit' | t }}
        </button>
      </div>
    </form>
  </div>
</div>

<section class="section">
  <div class="container-x">
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="collection__count" style="margin-bottom: 28px;">
          {{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>

        {%- if search.results.size > 0 -%}
          <div class="grid-4">
            {%- for item in search.results -%}
              <div class="reveal">
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <div class="card">
                    <div class="card__body">
                      <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                      <p class="muted" style="font-size: 0.92rem;">
                        {{ item.content | strip_html | truncatewords: 24 }}
                      </p>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
