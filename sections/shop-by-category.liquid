<section class="section" style="padding-top: 0;">
  <div class="container-x">
    {%- if section.settings.heading != blank -%}
      <div class="section-head reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="grid-tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign title = block.settings.title
          if title == blank and target != blank
            assign title = target.title
          endif
          assign img = block.settings.image
          if img == blank and target.featured_image != blank
            assign img = target.featured_image
          endif
        -%}
        <div
          class="reveal"
          style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms"
          {{ block.shopify_attributes }}
        >
          <a
            href="{% if target != blank %}{{ target.url }}{% else %}{{ block.settings.link | default: routes.all_products_collection_url }}{% endif %}"
            class="tile"
          >
            {%- if img != blank -%}
              <img
                src="{{ img | image_url: width: 800 }}"
                srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 800 }} 800w"
                sizes="(min-width: 1024px) 280px, 45vw"
                alt="{{ title | escape }}"
                width="600"
                height="800"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            <div class="tile__overlay">
              <h3>{{ title }}</h3>
              <span class="tile__cta">
                {{ 'sections.shop_by_category.shop_now' | t }}
                {% render 'icon', name: 'arrow-right', size: 15 %}
              </span>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 8,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "Link", "info": "Used when no collection is chosen." },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "Shop by category" }],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "tile", "settings": { "title": "Cooling Mats" } },
      { "type": "tile", "settings": { "title": "Sofa Protectors" } },
      { "type": "tile", "settings": { "title": "For Every Room" } },
      { "type": "tile", "settings": { "title": "Cat Comfort" } }
    ]
  }
}
{% endschema %}
