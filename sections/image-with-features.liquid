{%- comment -%}
  Two-column image + feature list. Serves both "Three layers of engineered
  chill" on the homepage and "Cool science, cosy result" on the product page.
{%- endcomment -%}

<section
  class="section {% if section.settings.background == 'cream' %}section-cream{% elsif section.settings.background == 'sage' %}section-sage{% endif %}"
  id="{{ section.settings.anchor | default: 'how' }}"
>
  <div class="container-x grid-2-split">
    <div class="reveal {% if section.settings.image_right %}order-last{% endif %}">
      <div class="media-frame">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 1024px) 560px, 90vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="{{ section.settings.fallback_image | default: 'construction.png' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            width="700"
            height="700"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>

    <div class="reveal" style="--reveal-delay: 0.15s">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="h3" style="margin: 8px 0 14px;">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="muted" style="margin-bottom: 24px;">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="feature-list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="feature-list__icon">
                {% render 'icon', name: block.settings.icon, size: 19 %}
              </span>
              <span><b>{{ block.settings.title }}</b> {{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="muted">{{ section.settings.footnote }}</p>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn-cool btn-lg">
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .order-last {
    order: 2;
  }
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .order-last {
      order: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Image with features",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Fallback asset filename",
      "default": "construction.png",
      "info": "A file in the theme's assets folder, used when no image is picked."
    },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "cream",
      "options": [
        { "value": "none", "label": "Page background" },
        { "value": "cream", "label": "Cream" },
        { "value": "sage", "label": "Sage" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Frischtier™ difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three layers of engineered chill" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "No electricity. No refrigeration. Just clever fabric science that draws heat away the moment your pet lies down."
    },
    { "type": "textarea", "id": "footnote", "label": "Footnote" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Feel the difference" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "how" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Bold lead-in", "default": "Ice-silk surface" },
        { "type": "text", "id": "text", "label": "Rest of line", "default": "— cool-to-touch, breathable and gentle on paws" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "snowflake",
          "options": [
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "cloud", "label": "Cloud" },
            { "value": "wind", "label": "Wind" },
            { "value": "washing-machine", "label": "Washing machine" },
            { "value": "droplets", "label": "Droplets" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "refresh-cw", "label": "Refresh" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "Image with features" }],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "feature", "settings": { "icon": "snowflake", "title": "Ice-silk surface", "text": "— cool-to-touch, breathable and gentle on paws" } },
      { "type": "feature", "settings": { "icon": "cloud", "title": "Padded cotton core", "text": "— soft support that won't flatten" } },
      { "type": "feature", "settings": { "icon": "wind", "title": "Reverse air-mesh", "text": "— vents warmth so it never gets clammy" } },
      { "type": "feature", "settings": { "icon": "washing-machine", "title": "Fully washable", "text": "— wipe clean or pop in the machine" } }
    ]
  }
}
{% endschema %}
