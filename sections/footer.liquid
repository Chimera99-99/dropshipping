{%- comment -%}
  Footer: brand blurb, up to three menu columns, payment icons and legal links.
{%- endcomment -%}

<footer class="footer">
  <div class="container-x">
    <div class="footer__grid">
      <div>
        <a href="{{ routes.root_url }}" class="logo">
          {%- if settings.logo != blank -%}
            <img
              class="logo__img"
              src="{{ settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name | escape }}"
              width="{{ settings.logo.width }}"
              height="{{ settings.logo.height }}"
            >
          {%- else -%}
            <span class="logo__mark">{% render 'icon', name: 'paw-print', size: 18 %}</span>
            {{ shop.name }}<span class="tm">™</span>
          {%- endif -%}
        </a>
        <p class="footer__blurb">{{ section.settings.blurb }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title | default: block.settings.menu.title }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span class="footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}&trade;. {{ 'general.rights_reserved' | t }}
      </span>

      {%- if section.settings.show_payment_icons -%}
        <div class="footer__pays">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- else -%}
            <span>VISA</span><span>MASTERCARD</span><span>AMEX</span>
            <span>PAYPAL</span><span>APPLE PAY</span><span>G PAY</span><span>KLARNA</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="footer__legal">
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Thoughtfully designed pet essentials that keep your best friend cool, calm and comfy — every season, every room."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "default": "footer"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "menu", "settings": { "title": "Discover" } },
      { "type": "menu", "settings": { "title": "Support" } },
      { "type": "menu", "settings": { "title": "Shop" } }
    ]
  }
}
{% endschema %}
