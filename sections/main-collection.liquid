<div class="page-head">
  <div class="container-x reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte muted" style="max-width: 640px; margin: 8px auto 0;">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>
</div>

<section class="section">
  <div class="container-x">
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="collection__toolbar">
        <span class="collection__count">
          {{ 'collections.general.product_count' | t: count: collection.products_count }}
        </span>

        {%- if section.settings.show_sort -%}
          <form method="get" action="{{ collection.url }}">
            <label class="visually-hidden" for="sort-by">{{ 'collections.sorting.title' | t }}</label>
            <select id="sort-by" name="sort_by" class="select" onchange="this.form.submit()">
              {%- assign current = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == current %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
              {%- endfor -%}
            {%- endfor -%}
          </form>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="grid-4">
          {%- for product in collection.products -%}
            <div class="reveal" style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">&larr;</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="{% if part.title == paginate.current_page %}is-current{% endif %}">
                  {{- part.title -}}
                </span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">&rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'collections.general.no_products' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="margin-top: 20px;">
            {{ 'collections.general.browse_all' | t }}
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Summer Collection" },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort dropdown", "default": true }
  ]
}
{% endschema %}
