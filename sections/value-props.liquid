<section class="section section-cream">
  <div class="container-x">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="grid-4">
      {%- for block in section.blocks -%}
        <div class="value" {{ block.shopify_attributes }}>
          <div class="value__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</div>
          <b>{{ block.settings.title }}</b>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Pet Parents Love It" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We made summer easier for your best friend" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Instant Cooling" },
        { "type": "textarea", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "snowflake",
          "options": [
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "wind", "label": "Wind" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "washing-machine", "label": "Washing machine" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "heart", "label": "Heart" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "settings": { "eyebrow": "Why Pet Parents Love It", "heading": "We made summer easier for your best friend" },
      "blocks": [
        { "type": "value", "settings": { "icon": "snowflake", "title": "Instant Cooling Relief", "text": "Activates the second your pet's weight touches the surface." } },
        { "type": "value", "settings": { "icon": "wind", "title": "No Setup Required", "text": "No fridge, no freezer, no water, no electricity." } },
        { "type": "value", "settings": { "icon": "leaf", "title": "Safe & Non-Toxic", "text": "No harsh chemicals — gentle on paws and skin." } },
        { "type": "value", "settings": { "icon": "washing-machine", "title": "Machine Washable", "text": "Built for daily use, easy to keep fresh." } }
      ]
    }
  ]
}
{% endschema %}
